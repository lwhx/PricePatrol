{
  "name": "price-patrol",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "concurrently -k \"tsx watch server/src/main.ts\" \"vite --config web/vite.config.ts\"",
    "start": "tsx server/src/main.ts",
    "build": "vite build --config web/vite.config.ts",
    "typecheck": "tsc --noEmit && vue-tsc --noEmit -p web/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest run --config web/vitest.config.ts",
    "check": "npm run typecheck && npm test && npm run test:ui && npm run build"
  },
  "dependencies": {
    "fastify": "^5.6.2",
    "@fastify/cookie": "^11.0.2",
    "@fastify/static": "^8.3.0",
    "@fastify/rate-limit": "^10.3.0",
    "tough-cookie": "^6.0.0",
    "undici": "^7.16.0",
    "zod": "^4.1.0",
    "tsx": "^4.20.6",
    "vue": "^3.5.22",
    "vue-router": "^4.6.3",
    "element-plus": "^2.11.5",
    "@element-plus/icons-vue": "^2.3.2",
    "ag-grid-community": "^34.3.1",
    "ag-grid-vue3": "^34.3.1",
    "playwright": "^1.56.1",
    "croner": "^9.1.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "@types/node": "^24.10.0",
    "vite": "^7.1.12",
    "@vitejs/plugin-vue": "^6.0.1",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.1.1",
    "concurrently": "^9.2.1",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^27.0.1"
  }
}
