# 复制为 .env；不要提交 .env、真实 Cookie、SendKey 或 data 目录。
# 运行 node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# 把输出填在下面。至少32字符，建议64位随机十六进制；首次启动前生成，升级时保留。
ENCRYPTION_KEY=

# Docker Compose 默认拉取已发布的双架构镜像（源码构建请参照 README）。
# 为避免 latest 随 main 更新，可以自行将 IMAGE 改为验证通过的 sha- 标签。
IMAGE=ghcr.io/lwhx/pricepatrol:latest
# IMAGE=ghcr.io/lwhx/pricepatrol:sha-完整提交SHA
# Compose 固定向所有接口发布宿主机 6300 端口（6300:3000）。
# 如要更改端口，请编辑 docker-compose.yaml 的 ports。
# 数据卷名。已用旧卷部署时保留 price-monitor-data，避免读不到原数据。
DATA_VOLUME=pricepatrol-data
# 自动备份使用独立本地卷；这不等于异机备份，异机挂载见 README。
BACKUP_VOLUME=pricepatrol-backups

# 本地 node 运行参数；Compose 会固定容器内部的 HOST/PORT/DATA_DIR。
HOST=127.0.0.1
PORT=3000
DATA_DIR=./data
# 通过HTTPS反向代理访问时设为true；本机HTTP开发时为false。
COOKIE_SECURE=false

# 可选：仅在数据库还没有管理员时生效。设置 10–200 个字符的 ADMIN_PASSWORD 可直接预置密码。
# 如需在网页初始化，可使用 32–256 个字符的 SETUP_TOKEN（建议 openssl rand -hex 32）；两项都留空时生产环境自动生成令牌。
# 用 docker compose exec app cat /app/data/.setup-token 从容器读取自动生成的令牌。
ADMIN_PASSWORD=
SETUP_TOKEN=

# Server酱SendKey在登录后的“设置”页面填写并开启通知，数据库加密保存；
# 不在这里写死，也不设置默认测试key。明确点击“测试通知”才发送真实测试消息。

# 跨店铺采集并发数 1–4，默认1；同一店铺始终串行。
COLLECTION_CONCURRENCY=1
