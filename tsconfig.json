{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "checkJs": false,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "node",
      "vitest/globals"
    ],
    "lib": [
      "ES2023",
      "DOM"
    ]
  },
  "include": [
    "server/**/*.ts",
    "shared/**/*.ts",
    "vitest.config.ts"
  ]
}