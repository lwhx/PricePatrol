# 复制为 deploy/.env（同目录），不要提交到 Git。
# 生成密钥：openssl rand -hex 32
# 至少 32 字符；首次生成后必须长期保留，Cookie 与 SendKey 解密都依赖它。
ENCRYPTION_KEY=

# 可选：仅在数据库还没有管理员时生效。设置 10–200 个字符的 ADMIN_PASSWORD 可直接预置密码。
# 如需在网页初始化，可使用 32–256 个字符的 SETUP_TOKEN（建议 openssl rand -hex 32）；两项都留空时生产环境自动生成令牌。
# 用 docker compose -f deploy/compose.yaml --env-file deploy/.env exec app cat /app/data/.setup-token 读取令牌。
ADMIN_PASSWORD=
SETUP_TOKEN=

# 镜像。建议固定已通过 CI 的 sha- 标签；latest 会随 main 更新。
IMAGE=ghcr.io/lwhx/pricepatrol:latest
# IMAGE=ghcr.io/lwhx/pricepatrol:sha-完整提交SHA

# Compose 默认向所有接口发布宿主机 6300 端口（6300:3000）。
# 如需限制外部访问，请配置防火墙或反向代理。

# 数据卷名。从旧版 price-monitor-data 迁移过来时，填旧卷名即可继续读原数据。
DATA_VOLUME=pricepatrol-data
# 自动备份使用独立本地卷；这不等于异机备份，异机挂载见 README。
BACKUP_VOLUME=pricepatrol-backups

# 通过 HTTPS 反向代理访问时设为 true。
COOKIE_SECURE=false

TZ=Asia/Shanghai

# 跨店铺采集并发数 1–4，默认1；同一店铺始终串行。
COLLECTION_CONCURRENCY=1
